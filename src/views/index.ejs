<!--Partial del header-->
<%- include('./partials/header', {title: 'Inicio' , customCSS: '/css/inicio.css' }) %>

  <main role="main" style="min-height: 80vh;">
    <!-- HERO -->
    <section class="hero-section" id="hero">
      <div class="vinyl-bg-animation">
        <div class="vinyl-disc vinyl-1"></div>
        <div class="vinyl-disc vinyl-2"></div>
        <div class="vinyl-disc vinyl-3"></div>
      </div>
      <div class="container hero-content">
        <div class="row align-items-center min-vh-100">
          <div class="col-lg-7" data-animate="fade-up">
            <p class="hero-label">TIENDA DE VINILOS — COSTA RICA</p>
            <h1 class="hero-title">
              El sonido<br>
              <em>que merece</em><br>
              ser vivido.
            </h1>
            <p class="hero-subtitle">
              Descubre nuestra colección curada de vinilos clásicos y modernos. Música en su forma más
              auténtica.
            </p>
            <div class="hero-cta d-flex gap-3 flex-wrap">
              <a href="/catalogo" class="btn btn-hero-primary">
                Explorar catálogo
                <span class="btn-arrow">→</span>
              </a>
              <a href="/registro" class="btn btn-hero-outline">
                Crear cuenta
              </a>
            </div>
          </div>
          <div class="col-lg-5 d-none d-lg-flex justify-content-center" data-animate="fade-left">
            <div class="hero-vinyl-showcase">
              <div class="showcase-disc">
                <div class="disc-label">
                  <span></span>
                </div>
              </div>
              <div class="showcase-sleeve"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-scroll-hint">
        <span>scroll</span>
        <div class="scroll-line"></div>
      </div>
    </section>

    <!-- TICKER -->
    <div class="ticker-wrap">
      <div class="ticker-track">
        <span>VINILOS &nbsp;·&nbsp; CLÁSICOS &nbsp;·&nbsp; MODERNOS &nbsp;·&nbsp; EDICIONES LIMITADAS
          &nbsp;·&nbsp;
          JAZZ &nbsp;·&nbsp; ROCK &nbsp;·&nbsp; POP &nbsp;·&nbsp; SOUL &nbsp;·&nbsp; FUNK &nbsp;·&nbsp; BLUES
          &nbsp;·&nbsp;</span>
        <span>VINILOS &nbsp;·&nbsp; CLÁSICOS &nbsp;·&nbsp; MODERNOS &nbsp;·&nbsp; EDICIONES LIMITADAS
          &nbsp;·&nbsp;
          JAZZ &nbsp;·&nbsp; ROCK &nbsp;·&nbsp; POP &nbsp;·&nbsp; SOUL &nbsp;·&nbsp; FUNK &nbsp;·&nbsp; BLUES
          &nbsp;·&nbsp;</span>
      </div>
    </div>

    <!-- GÉNEROS -->
    <section class="section-generos py-5" id="generos">
      <div class="container py-4">
        <div class="section-header mb-5" data-animate="fade-up">
          <p class="section-tag">EXPLORA POR GÉNERO</p>
          <h2 class="section-title">¿Qué quieres <em>escuchar hoy?</em></h2>
        </div>
        <div class="row g-3">
          <div class="col-6 col-md-4 col-lg-2" data-animate="fade-up" data-delay="0">
            <a href="/catalogo" class="genre-card">
              <div class="genre-icon">🎷</div>
              <span>Jazz</span>
            </a>
          </div>
          <div class="col-6 col-md-4 col-lg-2" data-animate="fade-up" data-delay="100">
            <a href="/catalogo" class="genre-card">
              <div class="genre-icon">🎸</div>
              <span>Rock</span>
            </a>
          </div>
          <div class="col-6 col-md-4 col-lg-2" data-animate="fade-up" data-delay="200">
            <a href="/catalogo" class="genre-card">
              <div class="genre-icon">🎵</div>
              <span>Pop</span>
            </a>
          </div>
          <div class="col-6 col-md-4 col-lg-2" data-animate="fade-up" data-delay="300">
            <a href="/catalogo" class="genre-card">
              <div class="genre-icon">🎹</div>
              <span>Soul</span>
            </a>
          </div>
          <div class="col-6 col-md-4 col-lg-2" data-animate="fade-up" data-delay="400">
            <a href="/catalogo" class="genre-card">
              <div class="genre-icon">🥁</div>
              <span>Funk</span>
            </a>
          </div>
          <div class="col-6 col-md-4 col-lg-2" data-animate="fade-up" data-delay="500">
            <a href="/catalogo" class="genre-card">
              <div class="genre-icon">🎺</div>
              <span>Blues</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- DESTACADOS -->
    <section class="section-destacados py-5" id="destacados">
      <div class="container py-4">
        <div class="d-flex justify-content-between align-items-end mb-5" data-animate="fade-up">
          <div>
            <p class="section-tag">SELECCIÓN EDITORIAL</p>
            <h2 class="section-title">Más <em>buscados</em></h2>
          </div>
          <a href="/catalogo" class="ver-todo-link">Ver todo →</a>
        </div>

        <div class="row g-4">
          <!-- Producto 1 -->
          <div class="col-6 col-md-4 col-lg-3" data-animate="fade-up" data-delay="0">
            <div class="product-card">
              <div class="product-img-wrap">
                <img src="../assets/images/portadas/vinilo-base.webp" alt="Álbum" class="img-fluid product-img">
                <div class="product-overlay">
                  <a href="/catalogo" class="btn-add-cart">+ Agregar</a>
                </div>
                <span class="product-badge">Nuevo</span>
              </div>
              <div class="product-info">
                <p class="product-artist">Michael Jackson</p>
                <h5 class="product-title">Thriller</h5>
                <div class="product-footer">
                  <span class="product-price">$10</span>
                  <span class="product-format">33 RPM · 12"</span>
                </div>
              </div>
            </div>
          </div>
          <!-- Producto 2 -->
          <div class="col-6 col-md-4 col-lg-3" data-animate="fade-up" data-delay="100">
            <div class="product-card">
              <div class="product-img-wrap">
                <img src="../assets/images/portadas/vinilo-base.webp" alt="Álbum" class="img-fluid product-img">
                <div class="product-overlay">
                  <a href="/catalogo" class="btn-add-cart">+ Agregar</a>
                </div>
                <span class="product-badge badge-limited">Limitado</span>
              </div>
              <div class="product-info">
                <p class="product-artist">Pink Floyd</p>
                <h5 class="product-title">The Dark Side of the Moon</h5>
                <div class="product-footer">
                  <span class="product-price">$18</span>
                  <span class="product-format">33 RPM · 12"</span>
                </div>
              </div>
            </div>
          </div>
          <!-- Producto 3 -->
          <div class="col-6 col-md-4 col-lg-3" data-animate="fade-up" data-delay="200">
            <div class="product-card">
              <div class="product-img-wrap">
                <img src="../assets/images/portadas/vinilo-base.webp" alt="Álbum" class="img-fluid product-img">
                <div class="product-overlay">
                  <a href="/catalogo" class="btn-add-cart">+ Agregar</a>
                </div>
              </div>
              <div class="product-info">
                <p class="product-artist">Fleetwood Mac</p>
                <h5 class="product-title">Rumours</h5>
                <div class="product-footer">
                  <span class="product-price">$15</span>
                  <span class="product-format">33 RPM · 12"</span>
                </div>
              </div>
            </div>
          </div>
          <!-- Producto 4 -->
          <div class="col-6 col-md-4 col-lg-3" data-animate="fade-up" data-delay="300">
            <div class="product-card">
              <div class="product-img-wrap">
                <img src="../assets/images/portadas/vinilo-base.webp" alt="Álbum" class="img-fluid product-img">
                <div class="product-overlay">
                  <a href="/catalogo" class="btn-add-cart">+ Agregar</a>
                </div>
                <span class="product-badge badge-limited">Limitado</span>
              </div>
              <div class="product-info">
                <p class="product-artist">David Bowie</p>
                <h5 class="product-title">Heroes</h5>
                <div class="product-footer">
                  <span class="product-price">$20</span>
                  <span class="product-format">33 RPM · 12"</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- POR QUÉ ELEGIRNOS -->
    <section class="section-why py-5">
      <div class="container py-4">
        <div class="section-header text-center mb-5" data-animate="fade-up">
          <p class="section-tag">POR QUÉ ELEGIRNOS</p>
          <h2 class="section-title">La experiencia <em>completa</em></h2>
        </div>
        <div class="row g-4">
          <div class="col-md-4" data-animate="fade-up" data-delay="0">
            <div class="why-card">
              <div class="why-number">01</div>
              <h4 class="why-title">Catálogo curado</h4>
              <p class="why-text">Cada vinilo en nuestra colección ha sido seleccionado por amantes de la
                música. Calidad garantizada en cada compra.</p>
            </div>
          </div>
          <div class="col-md-4" data-animate="fade-up" data-delay="150">
            <div class="why-card why-card-dark">
              <div class="why-number">02</div>
              <h4 class="why-title">Envío seguro</h4>
              <p class="why-text">Empaque especializado para vinilos, asegurando que tu música llegue en
                perfectas condiciones a donde estés.</p>
            </div>
          </div>
          <div class="col-md-4" data-animate="fade-up" data-delay="300">
            <div class="why-card">
              <div class="why-number">03</div>
              <h4 class="why-title">Ediciones especiales</h4>
              <p class="why-text">Accede a ediciones limitadas y rarezas que no encontrarás en ningún otro
                lugar. Sé el primero en saberlo.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BANNER CTA -->
    <section class="section-cta">
      <div class="container py-5">
        <div class="cta-inner" data-animate="fade-up">
          <p class="section-tag text-center">¿LISTO PARA EMPEZAR?</p>
          <h2 class="cta-title text-center">
            Tu próximo disco favorito<br>te está esperando.
          </h2>
          <div class="text-center mt-4">
            <a href="/catalogo" class="btn btn-cta">
              Ir al catálogo →
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!--Scripts unicos para la pagina-->
  <script src="/js/inicio.js"></script>
  <script src="/js/apiExterna.js"></script>

  <!--Partial del footer-->
  <%- include('./partials/footer') %>
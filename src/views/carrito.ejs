<!--Partial del header-->
<%- include('./partials/header', {title: 'Carrito' , customCSS: '/css/carrito.css' }) %>

    <main role="main" style="min-height: 80vh;">
        <div class="container">
            <div class="mb-5 d-flex flex-column">
                <h1 class="col-12 d-flex mt-5">Finalizar compra</h1>

                <div class="vinilos-comprar d-flex flex-column flex-lg-row col-12 justify-content-center">
                    <!--Inicia-->
                    <div class="col-12 col-lg-8 overflow-y-auto pe-2 mb-4" style="max-height: 70vh;">
                        <div class="vinilo d-flex col-12 flex-md-row mb-3 border border-dark overflow-hidden z-3">

                            <img class="col-4 d-none d-md-block img-fluid"
                                src="../assets/images/portadas/michael-jackson-thriller.jpg"
                                alt="Michael Jackson - Thriller">

                            <div class="col-12 col-md-8 d-flex flex-column justify-content-between p-3 bg-white">

                                <p class=" fs-5 mb-0 fw-bold">Thriller</p>
                                <p class="fs-5 mb-0">Artista: Michael Jackson</p>
                                <p class="fs-5 mb-0">Edición: Estándar</p>
                                <p class="fs-5 mb-0">Precio: $10</p>

                            </div>
                        </div>
                        <div class="vinilo d-flex col-12 flex-md-row mb-3 border border-dark overflow-hidden z-3">

                            <img class="col-4 d-none d-md-block img-fluid"
                                src="../assets/images/portadas/michael-jackson-thriller.jpg"
                                alt="Michael Jackson - Thriller">

                            <div class="col-12 col-md-8 d-flex flex-column justify-content-between p-3 bg-white">

                                <p class=" fs-5 mb-0 fw-bold">Thriller</p>
                                <p class="fs-5 mb-0">Artista: Michael Jackson</p>
                                <p class="fs-5 mb-0">Edición: Estándar</p>
                                <p class="fs-5 mb-0">Precio: $10</p>

                            </div>
                        </div>
                        <div class="vinilo d-flex col-12 flex-md-row mb-3 border border-dark overflow-hidden z-3">

                            <img class="col-4 d-none d-md-block img-fluid"
                                src="../assets/images/portadas/michael-jackson-thriller.jpg"
                                alt="Michael Jackson - Thriller">

                            <div class="col-12 col-md-8 d-flex flex-column justify-content-between p-3 bg-white">

                                <p class=" fs-5 mb-0 fw-bold">Thriller</p>
                                <p class="fs-5 mb-0">Artista: Michael Jackson</p>
                                <p class="fs-5 mb-0">Edición: Estándar</p>
                                <p class="fs-5 mb-0">Precio: $10</p>

                            </div>
                        </div>
                        <div class="vinilo d-flex col-12 flex-md-row mb-3 border border-dark overflow-hidden z-3">

                            <img class="col-4 d-none d-md-block img-fluid"
                                src="../assets/images/portadas/michael-jackson-thriller.jpg"
                                alt="Michael Jackson - Thriller">

                            <div class="col-12 col-md-8 d-flex flex-column justify-content-between p-3 bg-white">

                                <p class=" fs-5 mb-0 fw-bold">Thriller</p>
                                <p class="fs-5 mb-0">Artista: Michael Jackson</p>
                                <p class="fs-5 mb-0">Edición: Estándar</p>
                                <p class="fs-5 mb-0">Precio: $10</p>

                            </div>
                        </div>

                    </div>
                    <!--Finaliza-->

                    <div
                        class="pago  d-flex flex-column align-items-center justify-content-center card-body col-12 col-lg-4 col-md-12 border border-dark p-3">

                        <h4 class="card-title">Resumen del pedido</h4>
                        <div class="w-100 mt-3 d-flex flex-column">
                            <p class="fs-5 mb-0">Subtotal: $10</p>
                            <p class="fs-5 mb-0">Envio: $10</p>
                            <p class="fs-5 mb-0">Total: $10</p>
                        </div>

                        <div class="metodos-pago mt-3 w-100">
                            <h4 class="fs-4">Metodos de pago</h4>

                            <div class="btn d-flex p-3 border border-dark justify-content-between">
                                <div class="d-flex justify-content-between align-items-center w-100 me-2">
                                    <label for="metodo-pago">Tarjeta de credito</label>
                                    <img class="img-fluid" style="height: 30px;" src="../assets/images/master-card.webp"
                                        alt="Mastercard">
                                </div>
                                <input type="radio" name="metodo-pago" id="metodo-pago">
                            </div>

                            <div class="btn d-flex p-3 border border-dark justify-content-between">
                                <div class="d-flex justify-content-between align-items-center w-100 me-2">
                                    <label for="metodo-pago">Paypal</label>
                                    <img class="img-fluid" style="height: 30px;" src="../assets/images/paypal.png"
                                        alt="Paypal">
                                </div>
                                <input type="radio" name="metodo-pago" id="metodo-pago">
                            </div>

                        </div>
                        <button class="btn btn-dark w-80 mt-4 py-2 fw-bold">PAGAR</button>

                    </div>
                </div>
            </div>
        </div>
    </main>

    <!--Scripts unicos para la pagina-->
    <script src="../js/carrito.js"></script>

    <!--Partial del footer-->
    <%- include('./partials/footer') %>
<%- include('./partials/header', {title: 'Mi Perfil' , customCSS: '/css/perfil.css' }) %>

    <main role="main">

        <!-- HEADER DEL PERFIL -->
        <section class="perfil-header">
            <div class="container">
                <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">

                    <!-- Info principal -->
                    <div>
                        <p class="perfil-tag">PERFIL DE USUARIO</p>
                        <h1 class="perfil-nombre">
                            <span id="header-nombre">Nombre</span> <em><span id="header-apellido">Apellido</span></em>
                        </h1>
                        <p class="perfil-email" id="header-email">correo@mail.com</p>

                        <!-- Estadísticas -->
                        <div class="perfil-stats">
                            <div class="stat-item">
                                <span class="stat-numero" id="stat-ordenes">0</span>
                                <span class="stat-label">Órdenes</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-numero" id="stat-vinilos">0</span>
                                <span class="stat-label">Vinilos</span>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de acción, the user requested not to add them inside the header, but below in the existing blocks. -->
                </div>
            </div>
        </section>

        <!-- CONTENIDO PRINCIPAL -->
        <section class="perfil-contenido">
            <div class="container">
                <div class="row g-4">

                    <!-- COLUMNA IZQUIERDA -->
                    <div class="col-12 col-lg-4 d-flex flex-column gap-4">

                        <!-- Información personal -->
                        <div class="perfil-card">
                            <span class="card-tag">Datos personales</span>
                            <h2 class="card-titulo">Mi información</h2>

                            <div id="perfil-info" class="mb-auto">
                                <div class="text-center py-4">
                                    <div class="spinner-border text-dark" role="status"></div>
                                    <p class="mt-2">Cargando información...</p>
                                </div>
                            </div>

                            <!-- Botones de Acción -->
                            <div class="d-flex flex-row justify-content-between gap-2 mt-4 pt-4 border-top">
                                <button class="btn btn-sm flex-fill fw-bold bg-transparent" style="border: 1px solid #2176ff; color: #2176ff;" data-bs-toggle="modal"
                                    data-bs-target="#modal-editar-perfil">Editar Perfil</button>
                                <button id="btn-eliminar-cuenta" class="btn btn-sm flex-fill fw-bold bg-transparent" style="border: 1px solid #FF7257; color: #FF7257;">Eliminar mi cuenta</button>
                            </div>
                        </div>

                    </div>

                    <!-- COLUMNA DERECHA: Órdenes del Usuario -->
                    <div class="col-12 col-lg-8">
                        <div class="perfil-card">
                            <span class="card-tag">Compras</span>
                            <h2 class="card-titulo">Historial de órdenes</h2>
                            <div id="perfil-ordenes" class="pe-2" style="max-height: 550px; overflow-y: auto; overflow-x: hidden;">
                                <div class="text-center py-4">
                                    <div class="spinner-border text-dark" role="status"></div>
                                    <p class="mt-2">Cargando pedidos...</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </main>

    <!-- Modal Editar Perfil -->
    <div class="modal fade" id="modal-editar-perfil" tabindex="-1" aria-labelledby="modalEditarPerfilLabel"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-0">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEditarPerfilLabel">Editar Perfil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="form-editar-perfil">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label for="edit-nombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="edit-nombre" required>
                        </div>
                        <div class="mb-3">
                            <label for="edit-apellido" class="form-label">Apellidos</label>
                            <input type="text" class="form-control" id="edit-apellido" required>
                        </div>
                        <div class="mb-3">
                            <label for="edit-telefono" class="form-label">Teléfono</label>
                            <input type="text" class="form-control" id="edit-telefono">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="../js/perfil.js"></script>

    <%- include('./partials/footer') %>
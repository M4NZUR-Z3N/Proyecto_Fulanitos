<!--Partial del header-->
<%- include('./partials/header', {title: 'Catálogo' , customCSS: '/css/catalogo.css' }) %>

    <main role="main" style="min-height: 80vh;">
        <div class=" container d-flex flex-column justify-content-center align-items-center ">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center w-100 mt-4 px-2 px-md-5">
                <div class="invisible d-none d-md-block" style="width: 250px;"></div>
                <h1 class="text-center m-0">Catálogo</h1>
                <div class="mt-3 mt-md-0" style="width: 100%; max-width: 250px;">
                    <input type="text" id="buscador-catalogo" class="form-control" placeholder="Buscar...">
                </div>
            </div>

            <!--Empieza el div de discos-->

            <div id="bg-borroso"
                class="d-none bg-borroso btn position-fixed top-0 start-0 vh-100 vw-100 opacity-50 bg-dark z-2">
            </div>
            <div id="detalles"
                class="d-none detalles position-fixed top-0 start-0 vh-100 vw-100 d-flex justify-content-center align-items-center overflow-y-auto p-2 p-md-4 z-3">
                <div
                    class="col-11 col-md-10 col-lg-8 d-flex flex-column flex-md-row shadow-lg rounded overflow-hidden bg-white my-auto">

                    <div class="col-12 col-md-6 p-0" style="aspect-ratio: 1/1;">
                        <img id="detalle-cover" class="img-fluid h-100"
                            src="../assets/images/portadas/michael-jackson-thriller.jpg" alt="Portada del álbum"
                            style="object-fit: cover;">
                    </div>
                    <div class="col-12 col-md-6 d-flex flex-column justify-content-between g-2 p-3 p-lg-4 bg-white">
                        <div>
                            <p id="detalle-titulo" class="fs-4 fw-bold">Cargando...</p>
                            <p id="detalle-artista" class="fs-4">Artista: Cargando...</p>
                            <p id="detalle-genero" class="fs-4">Género: Cargando...</p>
                            <p id="detalle-anio" class="fs-4">Año de lanzamiento: Cargando...</p>
                            <p id="detalle-formato" class="fs-4">Formato: Cargando...</p>
                        </div>
                        <div class="d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="precios d-flex flex-column">
                                    <span id="detalle-precio" class="fs-5 text-dark">Precio unitario: $ 10</span>
                                    <span id="detalle-precio-total" class="fs-5 text-dark">Precio total: $ 10</span>
                                </div>
                                <div class="cantidad d-flex flex-column">
                                    <p class="fs-5 text-dark">Cantidad: <span id="cantidad">1</span></p>
                                    <div class="d-flex justify-content-between">
                                        <button id="boton-menos" class="btn btn-dark">-</button>
                                        <button id="boton-mas" class="btn btn-dark">+</button>
                                    </div>

                                </div>
                            </div>
                            <button id="boton-añadir" class="btn btn-dark w-80 mt-4 py-2 fw-bold ">AÑADIR AL
                                CARRITO</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="discos" class="row w-100">
            <!-- Productos se añaden aqui desde JS -->
        </div>

        <!--Termina el div de discos-->

        <ul class="pagination mt-3 mb-5 justify-content-center" id="paginacion-container">
            <li class="page-item"><a id="page-prev" class="rounded-start btn btn-dark z-1" href="#discos">Anterior</a></li>
            <li class="page-item"><a id="page-1" class="btn btn-dark z-1 active-page" href="#discos">1</a></li>
            <li class="page-item"><a id="page-2" class="btn btn-dark z-1" href="#discos">2</a></li>
            <li class="page-item"><a id="page-3" class="btn btn-dark z-1" href="#discos">3</a></li>
            <li class="page-item"><a id="page-next" class="rounded-end btn btn-dark z-1" href="#discos">Siguiente</a></li>
        </ul>
    </main>

    <!--Scripts unicos para la pagina-->
    <script src="/js/apiExterna.js"></script>
    <script src="/js/catalogo.js"></script>

    <!--Partial del footer-->
    <%- include('./partials/footer') %>
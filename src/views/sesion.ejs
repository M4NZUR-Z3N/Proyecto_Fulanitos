<!--Partial del header-->
<%- include('./partials/header', {title: 'Iniciar sesión' , customCSS: '/css/sesion.css' }) %>

    <main class="mt-5" role="main" style="min-height: 80vh;">
        <div class="container">
            <div class="p-2 text-center">
                <h1 class="display-4">Inicio de sesión</h1>
            </div>
            <div class="row g-5 mt-2 mb-5">
                <div class="col-md-7 col-lg-12">
                    <form class="needs-validation" action="catalogo.html" method="get">
                        <div class="row g-3">
                            <div class="col-sm-12">
                                <label for="email" class="form-label">Correo electrónico</label>
                                <input type="email" class="form-control" id="email" placeholder="" value="" required>
                                <div class="invalid-feedback">
                                    Favor ingresar un correo electrónico válido.
                                </div>
                            </div>

                            <div class="col-sm-12">
                                <label for="password" class="form-label">Contraseña</label>
                                <input type="password" class="form-control" id="password" placeholder="" required>
                                <div class="invalid-feedback">
                                    Favor ingresar una contraseña.
                                </div>
                            </div>
                            <div class="p-2 ">
                                <p class="text-start">¿Ha olvidado su contraseña?</p>
                            </div>
                        </div>

                        <hr class="my-4">

                        <button class="w-100 btn btn-dark btn-lg" type="submit">Iniciar sesión</button>
                    </form>
                    <div class="p-3 text-center">
                        <p class="text-center">¿No tiene cuenta?</p>
                        <a href="registro.html">Registrarse</a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!--Scripts unicos para la pagina-->
    <script src="../js/form-validation.js"></script>

    <!--Partial del footer-->
    <%- include('./partials/footer') %>
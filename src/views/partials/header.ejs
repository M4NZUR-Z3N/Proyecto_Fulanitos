<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" type="image/icon" href="/assets/icons/side-b.ico">
    <% if (customCSS) { %>
        <link rel="stylesheet" href="<%= customCSS %>">
        <% } %>
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link
                href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap"
                rel="stylesheet">
            <script src="../js/partials.js"></script>
</head>

<body>

    <header>
        <!-- NAVBAR -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark" id="navbar">
            <div class="container-fluid px-4">
                <a class="navbar-brand brand-logo" href="/">
                    <img src="../assets/icons/side-b-full-black.ico" height="60" alt="Side B Logo">
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false"
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="/">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="/catalogo">Catálogo</a>
                        </li>
                        <li class="nav-item" id="nav-item-carrito">
                            <a class="nav-link nav-link-custom" href="/carrito">Carrito</a>
                        </li>
                        <li class="nav-item" id="nav-item-perfil" style="display: none;">
                            <a class="nav-link nav-link-custom" href="#">Mi perfil</a>
                        </li>
                        <li class="nav-item ms-lg-3" id="nav-item-iniciar-sesion">
                            <a class="btn btn-outline-light btn-sm px-4" href="/sesion">Iniciar sesión</a>
                        </li>
                        <li class="nav-item" id="nav-item-registrarse">
                            <a class="btn btn-light btn-sm px-4 text-dark fw-bold" href="/registro">Registrarse</a>
                        </li>
                        <li class="nav-item ms-lg-3" id="nav-item-cerrar-sesion" style="display: none;">
                            <a class="btn btn-outline-danger btn-sm px-4" href="/">Cerrar sesión</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
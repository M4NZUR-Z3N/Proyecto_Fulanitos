{
  "name": "side-b",
  "version": "1.0.0",
  "description": "Side B — Tienda de Vinilos",
  "scripts": {
    "dev": "nodemon src/index.js",
    "sass:build": "sass --load-path=node_modules scss/inicio.scss css/inicio.css scss/catalogo.scss css/catalogo.css scss/carrito.scss css/carrito.css scss/landing-page.scss css/landing-page.css scss/forms.scss css/forms.css --style=compressed --no-source-map",
    "sass:watch": "sass --load-path=node_modules --watch scss/inicio.scss:css/inicio.css scss/catalogo.scss:css/catalogo.css scss/carrito.scss:css/carrito.css scss/landing-page.scss:css/landing-page.css scss/forms.scss:css/forms.css",
    "sass:dev": "sass --watch src/scss:public/css"
  },
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "nodemon": "^3.1.14",
    "sass": "^1.77.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "morgan": "^1.10.1"
  }
}

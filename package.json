{
  "name": "side-b",
  "version": "1.0.0",
  "description": "Side B — Tienda de Vinilos",
  "scripts": {
    "dev": "nodemon src/index.js",
    "sass:build": "sass --load-path=node_modules src/scss/inicio.scss:public/css/inicio.css src/scss/catalogo.scss:public/css/catalogo.css src/scss/carrito.scss:public/css/carrito.css src/scss/landing-page.scss:public/css/landing-page.css src/scss/forms.scss:public/css/forms.css src/scss/sesion.scss:public/css/sesion.css src/scss/perfil.scss:public/css/perfil.css --style=compressed --no-source-map",
    "sass:dev": "sass --load-path=node_modules --watch src/scss:public/css"
  },
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "nodemon": "^3.1.14",
    "sass": "^1.77.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "morgan": "^1.10.1"
  }
}
